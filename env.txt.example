# =============================================================================
# Agent-S3 配置文件 (env.txt)
# 复制此文件为 env.txt 并填入实际值:  cp env.txt.example env.txt
# env.txt 已在 .gitignore 中，不会被提交到仓库
# =============================================================================

# ─── 豆包主模型 (Doubao-seed-2.0-pro) ─────────────────────────────────────────
# 火山引擎 ARK 推理端点 ID 和 API Key
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/endpoint
ep-id: ep-xxxxxxxxxxxxx-xxxxx
api-key: ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── 豆包落地模型 (doubao-seed-1-6-vision-250815) ─────────────────────────────
# 用于 GUI 元素视觉定位，坐标空间 0-1000
ARK_API_KEY: ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── OpenAI GPT 主模型 ────────────────────────────────────────────────────────
# 推理与规划模型，支持 reasoning_effort 参数
oai_base_url: https://right.codes/codex/v1       # API 端点（兼容 /v1）
oai_api: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # API Key
model: gpt-5.4                                    # 模型名
model_reasoning_effort: high                      # 推理强度: low / medium / high / xhigh

# ─── 反射频率 ─────────────────────────────────────────────────────────────────
# 控制每步是否调用 LLM 反思上一步操作结果
# full:       每步均反思（最稳定，最慢）
# reduced:    每隔一步反思
# on_failure: 仅步骤失败时反思（默认，推荐）
# off:        不反思（最快，精度可能下降）
reflection_mode: on_failure
